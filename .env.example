# Copy to .env and fill in values. Never commit .env.
# Every key is optional: a provider is only required when it is selected below.

# --- Providers -------------------------------------------------------------
# Embeddings: "openai" (production) or "hash" (offline, deterministic, no key needed)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=your-openai-api-key

# Generation: "anthropic" (production) or "mock" (offline extractive answers)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
# Answering model: fast and cheap. Judge model (evals only): strongest available.
CHAT_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
JUDGE_MODEL=claude-opus-5-5

# --- Vector store ----------------------------------------------------------
# Default store when a request does not send vector_store: pinecone | pgvector | memory
# ("supabase" is accepted as an alias for pgvector.)
VECTOR_STORE=pinecone

# Pinecone: cosine index whose dimension matches EMBEDDING_DIM
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=rag-documents

# pgvector: any Postgres with the vector extension.
# Local docker-compose: postgresql://rag:rag@localhost:5432/rag
# Supabase: Project Settings > Database > Connection string (use the pooler URI)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
PGVECTOR_AUTO_MIGRATE=true

# --- Retrieval ---------------------------------------------------------------
CHUNK_STRATEGY=heading
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# --- Service -----------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_QUESTION_CHARS=2000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false
